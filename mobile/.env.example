# Copy this file to mobile/.env (never commit .env). After editing, restart with: npx expo start -c

# true = built-in sample data (default). false = use the real Django server below.
EXPO_PUBLIC_USE_MOCK=true

# Needed when EXPO_PUBLIC_USE_MOCK=false. Use the server's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Rehearse screen states with no hardware (mock mode only): ok | stale | offline | missing-sensor | empty
# EXPO_PUBLIC_MOCK_SCENARIO=ok
